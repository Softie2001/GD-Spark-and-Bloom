# Configure directly in Vercel Settings > Environment Variables (Preview first; Production after testing).
# NEVER commit actual values or put server secrets in site.js.
SUPABASE_URL=https://YOUR_NEW_GDSB_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SET_IN_VERCEL_ONLY
SUPABASE_ANON_KEY=SET_IN_VERCEL_ONLY
RESEND_API_KEY=SET_IN_VERCEL_ONLY
RESEND_FROM=GD Spark & Bloom <orders@YOUR_VERIFIED_DOMAIN>
ADMIN_NOTIFY_EMAIL=VENDOR_CONFIRMED_EMAIL_ADDRESS
ADMIN_REPLY_TO=OPTIONAL_REAL_REPLY_ADDRESS
SITE_ORIGIN=https://YOUR_SITE_DOMAIN
TURNSTILE_SITE_KEY=CLOUDFLARE_PUBLIC_SITE_KEY
TURNSTILE_SECRET_KEY=SET_IN_VERCEL_ONLY

# Cloudinary product and banner images (ONLY on the Vercel server)
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=ENTER_IN_VERCEL_ONLY
CLOUDINARY_API_SECRET=ENTER_IN_VERCEL_ONLY
